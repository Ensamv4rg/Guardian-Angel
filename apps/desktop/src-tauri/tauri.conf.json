{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guardian Angel",
  "version": "0.1.0",
  "identifier": "app.guardianangel.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Guardian Angel", "width": 1240, "height": 820, "minWidth": 960, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Guardian Angel",
    "category": "Utility",
    "shortDescription": "See and stop who is tracking you on this PC",
    "longDescription": "Guardian Angel finds trackers, telemetry and spyware on this computer, explains them in plain language, and blocks or fixes them when you choose.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/guardian-service"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Ensamv4rg/Guardian-Angel/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
